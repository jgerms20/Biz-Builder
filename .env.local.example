# Janie Bell's Alterations — Environment Variables
# Copy this file to .env.local and fill in your values before deploying.

# ─── Email Configuration ────────────────────────────────────────────────────
# The email address where booking form submissions will be sent (Joshua's email)
CONTACT_EMAIL=your-email@gmail.com

# Gmail account used to SEND the emails (can be a dedicated Gmail for the business)
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# To get one: Google Account → Security → 2-Step Verification → App passwords
# Generate one for "Mail" on "Other device" → name it "Janie Bells Site"
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
