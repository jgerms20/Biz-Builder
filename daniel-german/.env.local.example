# ============================================================
# DG Creations — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# These are required for the inquiry form email functionality.
# ============================================================

# The email address that inquiry form submissions will be sent TO
CONTACT_EMAIL=your-email@example.com

# Gmail account used to SEND emails (via Nodemailer)
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account
GMAIL_APP_PASSWORD=your-app-password-here
